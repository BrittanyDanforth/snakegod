-- Magnet visual effect
---------------------------------------------------------------------
local magnetEffects = {}

local function updateMagnetEffect(player)
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
		if magnetEffects[player] then
			magnetEffects[player]:Destroy()
			magnetEffects[player] = nil
		end
		return
	end

	local magnetRange = player:GetAttribute("MagnetRange") or 1
	local tempMagnetRange = player:GetAttribute("TempMagnetRange") or 1
	local totalRange = magnetRange * tempMagnetRange

	if totalRange > 1 then
		-- Create or update magnet effect
		if not magnetEffects[player] then
			-- Create main effect - a rotating ring
			local effect = Instance.new("Part")
			effect.Name = "MagnetEffect"
			effect.Shape = Enum.PartType.Cylinder
			effect.Material = Enum.Material.ForceField
			effect.Color = Color3.fromRGB(147, 51, 234)  -- Purple like the gamepass
			effect.Transparency = 0.7
			effect.CanCollide = false
			effect.CanQuery = false
			effect.CanTouch = false
			effect.Anchored = true
			effect.Parent = workspace

			-- Add inner glow
			local innerGlow = Instance.new("PointLight")
			innerGlow.Brightness = 2
			innerGlow.Color = Color3.fromRGB(147, 51, 234)
			innerGlow.Range = 20
			innerGlow.Parent = effect

			-- Add particle effect for extra visual appeal
			local attachment = Instance.new("Attachment")
			attachment.Parent = effect

			local particles = Instance.new("ParticleEmitter")
			particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			particles.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(147, 51, 234)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 100, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 100, 255))
			})
			particles.LightEmission = 1
			particles.LightInfluence = 0
			particles.Rate = 50 * totalRange  -- More particles for stronger magnet
			particles.Lifetime = NumberRange.new(1, 2)
			particles.Speed = NumberRange.new(5)
			particles.SpreadAngle = Vector2.new(360, 360)
			particles.VelocityInheritance = 0
			particles.EmissionDirection = Enum.NormalId.Top
			particles.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(0.5, 0.3),
				NumberSequenceKeypoint.new(1, 1)
			})
			particles.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.5),
				NumberSequenceKeypoint.new(0.5, 1),
				NumberSequenceKeypoint.new(1, 0)
			})
			particles.Rotation = NumberRange.new(0, 360)
			particles.RotSpeed = NumberRange.new(100)
			particles.Parent = attachment

			magnetEffects[player] = effect
		end

		local effect = magnetEffects[player]
		local hrp = player.Character.HumanoidRootPart

		-- Show actual magnet range
		local searchRange = 20 * totalRange  -- Match the actual search range

		-- Make it a flat horizontal ring on the ground
		effect.Size = Vector3.new(searchRange * 2, 0.2, searchRange * 2)  -- Very thin, wide circle
		effect.CFrame = CFrame.new(hrp.Position.X, 1, hrp.Position.Z) -- Position at ground level

		-- Rotate horizontally and spin
		effect.CFrame = effect.CFrame * CFrame.Angles(0, math.rad(tick() * 50), 0)

		-- Pulse effect
		local pulse = math.sin(tick() * 3) * 0.1 + 0.8
		effect.Transparency = pulse

		-- Update particle rate based on power
		local particles = effect:FindFirstChildOfClass("Attachment"):FindFirstChildOfClass("ParticleEmitter")
		if particles then
			particles.Rate = 50 * totalRange
		end
	else
		-- Remove effect if no magnet
		if magnetEffects[player] then
			magnetEffects[player]:Destroy()
			magnetEffects[player] = nil
		end
	end
end

-- Update magnet effects periodically
task.spawn(function()
	while true do
		task.wait(0.1)
		for _, player in pairs(Players:GetPlayers()) do
			updateMagnetEffect(player)
		end
	end
end)

