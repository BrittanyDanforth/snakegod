local function randomPosition()
	local a = getOrbSpawnArea()

	-- Try to find a gap area (up to 5 attempts)
	for attempt = 1, 5 do
		local testX = math.random(a.minX, a.maxX)
		local testZ = math.random(a.minZ, a.maxZ)
		local testPos = Vector3.new(testX, a.y, testZ)

		-- Use the existing getOrbsNearPosition function
		local nearbyOrbs = getOrbsNearPosition(testPos, 25) -- Reduced for denser orb placement

		-- If this area has few orbs, use it (fills gaps)
		if #nearbyOrbs < 3 then
			return testPos
		end
	end

	-- Fallback to completely random position
	return Vector3.new(math.random(a.minX, a.maxX), a.y, math.random(a.minZ, a.maxZ))
end

local function createOrb()
	local orb

	-- Check if we should spawn an upgrade orb
	if math.random() < UPGRADE_ORB_CHANCE then
		-- Try to get orb from pool first
		if pooledOrbCount > 0 then
			orb = table.remove(orbPool)
			pooledOrbCount = pooledOrbCount - 1
			-- Reset and configure as upgrade orb
			orb.Name = "UpgradeOrb"
			orb.Color = Color3.fromRGB(0, 150, 255)  -- Darker blue
			orb.Material = Enum.Material.ForceField
			orb.Transparency = 0.3  -- Make it semi-transparent
			orb.Size = Vector3.new(5, 5, 5)  -- Slightly larger
			orb.Position = randomPosition()
			orb.Parent = workspace
			local val = orb:FindFirstChild("Value")
			if val then val.Value = 0 end
		else
			orb = createSafeOrb(randomPosition(), 0, "UpgradeOrb",
				Color3.fromRGB(0, 150, 255), Enum.Material.ForceField)
		end
		upgradeOrbs[#upgradeOrbs + 1] = orb
		orbs[#orbs + 1] = orb
	else
		-- Regular orb - try pool first
		if pooledOrbCount > 0 then
			orb = table.remove(orbPool)
			pooledOrbCount = pooledOrbCount - 1
			-- Reset and configure as regular orb
			orb.Name = "Orb"
			orb.Color = Color3.fromRGB(255, 255, 0)
			orb.Material = Enum.Material.Neon
			orb.Position = randomPosition()
			orb.Parent = workspace
			local val = orb:FindFirstChild("Value")
			if val then val.Value = 5 end  -- Increased for faster growth

			-- Add to OrbUtils tracking
			-- OrbUtils.registerOrb(orb) -- Function doesn't exist
		else
			orb = OrbUtils.spawnOrbAt(randomPosition(), 1)
		end

		if orb then
			-- CRITICAL FIX: Add regular orbs to the orbs array!
			orbs[#orbs + 1] = orb

			-- Start orbs visible at medium distance
			orb.Transparency = 0.3
			orb.Size = Vector3.new(1.5, 1.5, 1.5)
			orbStates[orb] = {state = "far", fade = 0.7}
			local light = orb:FindFirstChild("PointLight")
			if light then 
				light.Enabled = true
				light.Brightness = 1.4
				light.Range = 5.6
			end
			addOrbToGrid(orb) -- Add to grid
		end
	end
	if orb then attachOrbTouched(orb) end
	return orb
end

