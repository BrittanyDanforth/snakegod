-- OPTIMIZATION: Spatial grid for efficient collision detection
local GRID_SIZE = 50  -- Size of each grid cell
local orbGrid = {}    -- Spatial partitioning grid

local function getGridKey(position)
	local x = math.floor(position.X / GRID_SIZE)
	local z = math.floor(position.Z / GRID_SIZE)
	return x .. "," .. z
end

local function addOrbToGrid(orb)
	local key = getGridKey(orb.Position)
	if not orbGrid[key] then
		orbGrid[key] = {}
	end
	orbGrid[key][orb] = true
end

local function removeOrbFromGrid(orb)
	local key = getGridKey(orb.Position)
	if orbGrid[key] then
		orbGrid[key][orb] = nil
		if next(orbGrid[key]) == nil then
			orbGrid[key] = nil
		end
	end
end

local function getOrbsNearPosition(position, radius)
	local nearbyOrbs = {}
	local cellRadius = math.ceil(radius / GRID_SIZE)
	local centerX = math.floor(position.X / GRID_SIZE)
	local centerZ = math.floor(position.Z / GRID_SIZE)

	for dx = -cellRadius, cellRadius do
		for dz = -cellRadius, cellRadius do
			local key = (centerX + dx) .. "," .. (centerZ + dz)
			if orbGrid[key] then
				for orb, _ in pairs(orbGrid[key]) do
					if orb and orb.Parent then
						local dist = (orb.Position - position).Magnitude
						if dist <= radius then
							table.insert(nearbyOrbs, orb)
						end
					end
				end
			end
		end
	end

	return nearbyOrbs
end

---------------------------------------------------------------------
-- Utility: get all player heads
---------------------------------------------------------------------
local function getPlayerHeads()
	local heads = {}
	for _, p in Players:GetPlayers() do
		-- First check for HumanoidRootPart
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if root then 
			table.insert(heads, {player = p, part = root}) 
		end

		-- Also check for SnakeHead parts
		if p.Character then
			-- Look for SnakeHead in character
			local snakeHead = p.Character:FindFirstChild("SnakeHead")
			if snakeHead then
				table.insert(heads, {player = p, part = snakeHead})
			end

			-- Also check descendants for SnakeHead
			for _, desc in pairs(p.Character:GetDescendants()) do
				if desc:IsA("BasePart") and desc.Name == "SnakeHead" then
					table.insert(heads, {player = p, part = desc})
					break -- Only need one head per player
				end
			end
		end
	end
	return heads
end

