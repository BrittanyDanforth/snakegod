---------------------------------------------------------------------
-- Pre-populate orb pool for performance
---------------------------------------------------------------------
local function populateOrbPool()
	print("Pre-creating orb pool...")
	for i = 1, ORB_POOL_SIZE do
		local orb = Instance.new("Part")
		orb.Name = "PooledOrb"
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(0.1, 0.1, 0.1)
		orb.Anchored = true
		orb.CanCollide = false
		orb.CanTouch = true
		orb.TopSurface = Enum.SurfaceType.Smooth
		orb.BottomSurface = Enum.SurfaceType.Smooth
		orb.Transparency = 1

		local val = Instance.new("NumberValue")
		val.Name = "Value"
		val.Value = 1
		val.Parent = orb

		local light = Instance.new("PointLight")
		light.Parent = orb
		light.Enabled = false
		light.Shadows = false

		table.insert(orbPool, orb)
		pooledOrbCount = pooledOrbCount + 1

		-- Yield every 10 orbs to prevent lag spike
		if i % 10 == 0 then
			task.wait()
		end
	end
	print("Orb pool ready with", pooledOrbCount, "orbs")
end

-- Pre-populate pool before spawning orbs
populateOrbPool()

