task.spawn(function()
	-- Wait for pool to be ready
	while pooledOrbCount < ORB_POOL_SIZE / 2 do
		task.wait(0.1)
	end

	-- Spawn initial orbs in batches
	local batchSize = 50
	while #orbs < ORB_MAX do
		for i = 1, batchSize do
			if #orbs < ORB_MAX then
				createOrb()
			end
		end
		task.wait(0.1) -- Small delay between batches
	end
end)

task.spawn(function()
	while true do 
		task.wait(ORB_SPAWN_INTERVAL)
		-- Batch spawn to reduce overhead
		local orbsToSpawn = math.min(50, ORB_MAX - #orbs)
		for i = 1, orbsToSpawn do
			if #orbs < ORB_MAX then 
				createOrb() 
			else
				break
			end
		end
	end
end)

