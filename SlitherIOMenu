		-- FPS update loop
		local lastUpdate = tick()
		local frameCount = 0

		RunService.RenderStepped:Connect(function()
			if not fpsCounter or not fpsCounter.Parent then return end

			frameCount = frameCount + 1
			local now = tick()
			local elapsed = now - lastUpdate

			if elapsed >= 0.5 then
				local fps = math.floor(frameCount / elapsed)
				fpsCounter.Text = "FPS: " .. fps

				-- Color code based on performance
				if fps >= 50 then
					fpsCounter.TextColor3 = Color3.fromRGB(76, 217, 100)
				elseif fps >= 30 then
					fpsCounter.TextColor3 = Color3.fromRGB(255, 200, 0)
				else
					fpsCounter.TextColor3 = Color3.fromRGB(255, 80, 80)
				end

				lastUpdate = now
				frameCount = 0
			end
		end)
	end

