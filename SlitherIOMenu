-- Function to create the menu UI
local function createMenu(onPlay)
	-- Load settings and stats
	loadSettings()
	loadPlayerStats()
	checkDailyReward()

	-- Get theme colors
	local theme = CONFIG.THEMES[currentTheme]

	-- Destroy any existing menu first
	if currentMenu then
		currentMenu:Destroy()
		currentMenu = nil
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "SlitherIOMenu"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 10

	-- Dark background with gradient
	local bgFrame = Instance.new("Frame")
	bgFrame.Size = UDim2.new(1, 0, 1, 0)
	bgFrame.Position = UDim2.new(0, 0, 0, 0)
	bgFrame.BackgroundColor3 = theme.background[1]
	bgFrame.BackgroundTransparency = 0
	bgFrame.BorderSizePixel = 0
	bgFrame.Parent = screenGui

	-- Enhanced gradient with more depth
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, theme.background[1]),
		ColorSequenceKeypoint.new(0.3, theme.background[2]),
		ColorSequenceKeypoint.new(0.7, theme.background[3]),
		ColorSequenceKeypoint.new(1, theme.background[4])
	}
	gradient.Rotation = 90
	gradient.Parent = bgFrame

	-- Create enhanced animated particles with glow
	if settings.particlesEnabled then
		for i = 1, CONFIG.PARTICLE_COUNT do
			local particleType = CONFIG.PARTICLE_TYPES[math.random(1, #CONFIG.PARTICLE_TYPES)]
			local size = math.random(4, 12)
			local color = i % 3 == 0 and theme.primary or
				(i % 3 == 1 and theme.secondary or
					Color3.fromRGB(255, 255, 255))

			local particle = createParticle(bgFrame, particleType, color, size)

			-- Enhanced floating animation
			spawn(function()
				while screenGui.Parent do
