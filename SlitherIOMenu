-- Create a button with glass effect
local function createGlassButton(parent, size, position, text, cornerRadius, textColor, backgroundColor, transparency, textSize)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = backgroundColor or Color3.fromRGB(255, 255, 255)
	button.BackgroundTransparency = transparency or 0.92
	button.Text = text
	button.Font = Enum.Font.SourceSans
	button.TextScaled = textSize == nil

	if textSize then
		button.TextSize = textSize
	end

	button.TextColor3 = textColor or Color3.fromRGB(220, 220, 220)
	button.AutoButtonColor = false
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = cornerRadius or UDim.new(0, 12)
	corner.Parent = button

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.85
	stroke.Thickness = 1
	stroke.Parent = button

	-- Add hover and click effects
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			BackgroundTransparency = transparency and transparency - 0.07 or 0.85,
			TextColor3 = Color3.fromRGB(255, 255, 255)
		}):Play()

		TweenService:Create(stroke, TweenInfo.new(0.15), {
			Transparency = 0.75
		}):Play()
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			BackgroundTransparency = transparency or 0.92,
			TextColor3 = textColor or Color3.fromRGB(220, 220, 220)
		}):Play()

		TweenService:Create(stroke, TweenInfo.new(0.15), {
			Transparency = 0.85
		}):Play()
	end)

	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.05), {
			Size = UDim2.new(button.Size.X.Scale * 0.95, 0, button.Size.Y.Scale * 0.95, 0)
		}):Play()
	end)

	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.05), {
			Size = size
		}):Play()
	end)

	return button
end

