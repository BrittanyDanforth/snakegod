-- Check daily reward
local function checkDailyReward()
	local currentDate = os.time()
	local dayInSeconds = 86400 -- 24 hours

	pcall(function()
		if readfile and isfile and isfile(CONFIG.DAILY_REWARD_KEY .. ".json") then
			local content = readfile(CONFIG.DAILY_REWARD_KEY .. ".json")
			local decoded = game:GetService("HttpService"):JSONDecode(content)

			dailyReward.lastClaimed = decoded.lastClaimed or 0
			dailyReward.streak = decoded.streak or 0
		end
	end)

	-- Check if a new day has passed since last claim
	if currentDate - dailyReward.lastClaimed > dayInSeconds then
		dailyReward.available = true

		-- Check if streak should continue or reset (48 hours)
		if currentDate - dailyReward.lastClaimed > dayInSeconds * 2 then
			dailyReward.streak = 0
		end
	else
		dailyReward.available = false
	end
end

-- Claim daily reward
local function claimDailyReward()
	if not dailyReward.available then return end

	dailyReward.streak = dailyReward.streak + 1
	dailyReward.lastClaimed = os.time()
	dailyReward.available = false

	-- Save to file
	pcall(function()
		local encoded = game:GetService("HttpService"):JSONEncode(dailyReward)
		if writefile then
			writefile(CONFIG.DAILY_REWARD_KEY .. ".json", encoded)
		end
	end)

	-- Return reward based on streak
	local rewards = {
		{type = "coins", amount = 100},
		{type = "coins", amount = 200},
		{type = "coins", amount = 300},
		{type = "coins", amount = 400},
		{type = "coins", amount = 500},
		{type = "coins", amount = 750},
		{type = "skin", id = "premium_" .. math.random(1, 3)}
	}

	local day = math.min(dailyReward.streak, #rewards)
	return rewards[day]
end

-- Enhanced respawn system with username
local function requestRespawn()
	-- Ensure RemoteEvent exists
	local respawnEvent = ReplicatedStorage:FindFirstChild("RespawnSnake")
	if not respawnEvent then
		-- Create it if it doesn't exist (for studio testing)
		respawnEvent = Instance.new("RemoteEvent")
		respawnEvent.Name = "RespawnSnake"
		respawnEvent.Parent = ReplicatedStorage
		print("Created RespawnSnake RemoteEvent")
	end

	-- Update stats
	playerStats.gamesPlayed = playerStats.gamesPlayed + 1
	savePlayerStats()

	-- Get username or use default
	local username = LocalPlayer:GetAttribute("SlitherUsername") or LocalPlayer.Name

	-- Send username with respawn
	respawnEvent:FireServer(username)
end

-- Create a particle effect
local function createParticle(parent, particleType, color, size, position)
	local particle = Instance.new("Frame")
	particle.Size = UDim2.new(0, size, 0, size)
	particle.Position = position or UDim2.new(math.random(), 0, math.random(), 0)
	particle.BackgroundColor3 = color
	particle.BackgroundTransparency = 0.6
	particle.BorderSizePixel = 0
	particle.Parent = parent

	if particleType == "circle" then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = particle
	elseif particleType == "square" then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, math.floor(size * 0.2))
		corner.Parent = particle
	elseif particleType == "triangle" then
		-- Simulate triangle with an image
		particle.BackgroundTransparency = 1
		local image = Instance.new("ImageLabel")
		image.Size = UDim2.new(1, 0, 1, 0)
		image.Position = UDim2.new(0, 0, 0, 0)
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://7072720023" -- Triangle image
		image.ImageColor3 = color
		image.ImageTransparency = 0.6
		image.Parent = particle
	elseif particleType == "star" then
		-- Simulate star with an image
		particle.BackgroundTransparency = 1
		local image = Instance.new("ImageLabel")
		image.Size = UDim2.new(1, 0, 1, 0)
		image.Position = UDim2.new(0, 0, 0, 0)
		image.BackgroundTransparency = 1
		image.Image = "rbxassetid://7072719338" -- Star image
		image.ImageColor3 = color
		image.ImageTransparency = 0.6
		image.Parent = particle
	end

	-- Add glow effect
	local glow = Instance.new("ImageLabel")
	glow.Size = UDim2.new(3, 0, 3, 0)
	glow.Position = UDim2.new(-1, 0, -1, 0)
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://7072718362" -- Glow image
	glow.ImageColor3 = color
	glow.ImageTransparency = 0.8
	glow.ZIndex = particle.ZIndex - 1
	glow.Parent = particle

	return particle
end

