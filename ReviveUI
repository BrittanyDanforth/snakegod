-- Initialize UI
local reviveUI, yesButton, noButton, timerBar, buyButton, lengthInfo, reviveInfo, reviveCount, processingText = createReviveUI()

-- Variables
local isShowing = false
local isPurchasing = false
local timerConnection = nil

-- Centralized function to close the prompt and clean up
local function closeRevivePrompt()
	if not isShowing then return end
	isShowing = false

	if timerConnection then
		timerConnection:Disconnect()
		timerConnection = nil
	end

	-- Animate exit
	local container = reviveUI.Container
	TweenService:Create(container, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
		Size = UDim2.new(0, 0, 0, 0)
	}):Play()
	task.wait(0.2)
	reviveUI.Enabled = false

	-- CRITICAL: Signal that the prompt is no longer active
	player:SetAttribute("RevivePromptActive", false)
end

-- Centralized function to send response to server
local function handleResponse(response)
	if isShowing then
		promptReviveRemote:FireServer(response)
		closeRevivePrompt()
	end
end

-- Handle revive prompt from server
promptReviveRemote.OnClientEvent:Connect(function()
	if isShowing then return end
	isShowing = true
	isPurchasing = false

	-- CRITICAL: Signal that the prompt is now active
	player:SetAttribute("RevivePromptActive", true)

	local actualDeathLength = 0
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats and leaderstats:FindFirstChild("Length") then
		actualDeathLength = leaderstats.Length.Value or 0
	end

	local reviveLength = math.floor(actualDeathLength * UI_CONFIG.REVIVE_PERCENTAGE)
	lengthInfo.Text = "Your length: " .. tostring(actualDeathLength)
	reviveInfo.Text = "Revive at " .. tostring(reviveLength) .. " length!"

	local revivesAvailable = player:GetAttribute("RevivesAvailable") or 0
	reviveCount.Text = "Revives remaining: " .. tostring(revivesAvailable)

	if revivesAvailable > 0 then
		yesButton.Visible = true
		buyButton.Visible = false
	else
		yesButton.Visible = false
		buyButton.Visible = true
	end

	reviveUI.Enabled = true
	processingText.Visible = false
	local container = reviveUI.Container
	container.Position = UDim2.new(0.5, 0, 0.5, 0)
	container.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(container, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
		Size = UDim2.new(0.4, 0, 0.35, 0)
	}):Play()

	-- Start timer
	local startTime = tick()
	local duration = 5
	if timerConnection then timerConnection:Disconnect() end
	timerConnection = RunService.Heartbeat:Connect(function()
		if not isPurchasing then
			local elapsed = tick() - startTime
			local remaining = math.max(0, duration - elapsed)
			timerBar.Size = UDim2.new(remaining / duration, 0, 0.02, 0)
			if remaining <= 0 then
				handleResponse("decline") -- Auto-decline if time runs out
			end
		end
	end)
end)

-- Button Connections
yesButton.MouseButton1Click:Connect(function()
	if not isPurchasing then handleResponse("revive") end
end)

noButton.MouseButton1Click:Connect(function()
	if not isPurchasing then handleResponse("decline") end
end)

buyButton.MouseButton1Click:Connect(function()
	if not isPurchasing then
		isPurchasing = true
		processingText.Visible = true
		if timerConnection then timerConnection:Disconnect() end -- Pause timer

		pcall(function()
			MarketplaceService:PromptProductPurchase(player, UI_CONFIG.REVIVE_PRODUCT_ID)
		end)
	end
end)

-- Listen for purchase completion
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if userId == player.UserId and productId == UI_CONFIG.REVIVE_PRODUCT_ID and isShowing then
		if wasPurchased then
			print("Revive purchased successfully!")
			-- Tell the server to use the revive we just bought
			handleResponse("revive")
		else
			print("Purchase cancelled.")
			-- The player cancelled, so this is a decline
			handleResponse("decline")
		end
	end
end)

print("ReviveUI with Robux purchase loaded!")
